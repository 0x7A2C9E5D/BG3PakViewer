<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platforms>x64</Platforms>
        <RootNamespace>BG3PakViewer.IconAtlas</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="OpenCvSharp5" Version="5.1.0.20261115"/>
        <PackageReference Include="OpenCvSharp5.runtime.win.slim" Version="5.1.0.20261115"/>
        <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3"/>
        <PackageReference Include="SonarAnalyzer.CSharp" Version="10.36.0.15337">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.IO.Hashing" Version="11.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BG3PakViewer.Utils\BG3PakViewer.Utils.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="sixlabors.lic"/>
    </ItemGroup>

</Project>
