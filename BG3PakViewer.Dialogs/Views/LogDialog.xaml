<Window x:Class="BG3PakViewer.Dialogs.Views.LogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:sf="http://schemas.syncfusion.com/wpf"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:l="clr-namespace:BG3PakViewer.Locales;assembly=BG3PakViewer.Locales"
        xmlns:vm="clr-namespace:BG3PakViewer.Dialogs.ViewModels"
        xmlns:b="clr-namespace:BG3PakViewer.Dialogs.Behaviors"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        WindowChrome.IsHitTestVisibleInChrome="True"
        d:DataContext="{d:DesignInstance Type=vm:LogDialogViewModel}"
        WindowStartupLocation="CenterScreen"
        Title="{I18N {x:Static l:LangKeys.Log}}" Height="800" Width="1200">
    <i:Interaction.Behaviors>
        <b:LogDialogBehavior />
    </i:Interaction.Behaviors>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="RightPaddingColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Text="{I18N {x:Static l:LangKeys.Log}}" />
                <ui:AutoSuggestBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    PlaceholderText="{I18N {x:Static l:LangKeys.Search}}"
                    QuerySubmitted="AutoSuggestBox_OnQuerySubmitted"
                    TextChanged="AutoSuggestBox_OnTextChanged">
                    <ui:AutoSuggestBox.QueryIcon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Search}" />
                    </ui:AutoSuggestBox.QueryIcon>
                </ui:AutoSuggestBox>
                <Button Grid.Column="2" Height="48" Width="48" Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Right" Command="{Binding OpenLogFolderCommand}">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Folder}" />
                </Button>
            </Grid>
            <sf:SfDataGrid
                x:Name="SfDataGrid"
                Grid.Row="1"
                Margin="16,16,16,0"
                AllowDeleting="True"
                AllowResizingColumns="True"
                AutoGenerateColumns="False"
                HeaderRowHeight="25"
                ItemsSource="{Binding PagedSource, ElementName=SfDataPager, Mode=TwoWay}"
                NavigationMode="Row"
                RowHeight="30"
                SelectionMode="Extended"
                ShowRowHeader="True"
                GridPasteOption="None">
                <sf:SfDataGrid.Resources>
                    <ResourceDictionary>
                        <Style TargetType="sf:GridRowHeaderCell">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="sf:GridRowHeaderCell">
                                        <Border
                                            x:Name="PART_RowHeaderCellBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding RowIndex, RelativeSource={RelativeSource TemplatedParent}}"
                                                    TextAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ResourceDictionary>
                </sf:SfDataGrid.Resources>
                <i:Interaction.Behaviors>
                    <b:SfDataGridBehavior MinHeight="{Binding ElementName=SfDataGrid, Path=RowHeight}" />
                </i:Interaction.Behaviors>
                <sf:SfDataGrid.Columns>
                    <sf:GridDateTimeColumn
                        ColumnSizer="SizeToHeader"
                        HeaderText="{I18N {x:Static l:LangKeys.LogTime}}"
                        MappingName="Timestamp"
                        MinimumWidth="200"
                        Pattern="FullDateTime"
                        TextAlignment="Center" />
                    <sf:GridTextColumn
                        ColumnSizer="SizeToHeader"
                        HeaderText="{I18N {x:Static l:LangKeys.LogLevel}}"
                        MappingName="Level"
                        MinimumWidth="150"
                        TextAlignment="Center" />
                    <sf:GridTextColumn
                        ColumnSizer="AutoWithLastColumnFill"
                        HeaderText="{I18N {x:Static l:LangKeys.LogMessage}}"
                        MappingName="Message"
                        MinimumWidth="700"
                        TextWrapping="WrapWithOverflow" />
                </sf:SfDataGrid.Columns>
            </sf:SfDataGrid>
            <sf:SfDataPager
                x:Name="SfDataPager"
                Grid.Row="2"
                Margin="0,4"
                HorizontalAlignment="Center"
                NumericButtonCount="10"
                PageSize="30"
                Source="{Binding LogEvents}">
                <i:Interaction.Behaviors>
                    <b:SfDataPagerBehavior />
                </i:Interaction.Behaviors>
            </sf:SfDataPager>
        </Grid>
    </Grid>
</Window>