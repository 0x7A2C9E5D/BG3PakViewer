<Window x:Class="BG3PakViewer.Dialogs.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:iwk="http://schemas.inkore.net/lib/ui/wpf"
        xmlns:l="clr-namespace:BG3PakViewer.Locales;assembly=BG3PakViewer.Locales"
        xmlns:vm="clr-namespace:BG3PakViewer.Dialogs.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:c="clr-namespace:BG3PakViewer.Shared.Converters;assembly=BG3PakViewer.Shared"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        WindowChrome.IsHitTestVisibleInChrome="True"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="{I18N {x:Static l:LangKeys.Settings}}" Height="800" Width="800"
        d:DataContext="{d:DesignInstance vm:SettingsDialogViewModel}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
                    <Style
                        x:Key="SettingsSectionHeaderTextBlockStyle"
                        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                        TargetType="TextBlock">
                        <Style.Setters>
                            <Setter Property="Margin" Value="1,30,0,6" />
                        </Style.Setters>
                    </Style>
                </ResourceDictionary>
                <ResourceDictionary>
                    <c:StringToCultureInfoConverter x:Key="StringToCultureInfoConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Text="{I18N {x:Static l:LangKeys.Settings}}" />
            <ScrollViewer Grid.Row="1">
                <iwk:SimpleStackPanel Margin="36,0" Spacing="4">
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                               Text="{I18N {x:Static l:LangKeys.PreviewSettingHeader}}" />
                    <ui:SettingsCard Description="{I18N  {x:Static l:LangKeys.MaxPreviewLinesDescription}}"
                                     Header="{I18N {x:Static l:LangKeys.MaxPreviewLinesHeader}}">
                        <ui:SettingsCard.Resources>
                            <x:Array x:Key="PageSizes" Type="sys:Int32">
                                <sys:Int32>200</sys:Int32>
                                <sys:Int32>500</sys:Int32>
                                <sys:Int32>1000</sys:Int32>
                            </x:Array>
                        </ui:SettingsCard.Resources>
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.PenPalette}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox ItemsSource="{StaticResource PageSizes}"
                                  SelectedItem="{Binding Settings.MaxPreviewLines,Mode=TwoWay}" />
                    </ui:SettingsCard>
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                               Text="{I18N {x:Static l:LangKeys.DirectorySettingsHeader}}" />
                    <ui:SettingsCard Header="{I18N {x:Static l:LangKeys.DefaultOpenDirectoryHeader}}">
                        <ui:SettingsCard.Description>
                            <Grid>
                                <TextBlock Text="{Binding Settings.DefaultOpenDirectory}" />
                                <TextBlock Text="{I18N {x:Static l:LangKeys.DefaultOpenDirectoryDescription}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.DefaultOpenDirectory}"
                                                             Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </ui:SettingsCard.Description>
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.FolderOpen}" />
                        </ui:SettingsCard.HeaderIcon>
                        <iwk:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                            <Button Command="{Binding SetDefaultOpenDirectoryCommand}">
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Search}" />
                            </Button>
                            <Button Command="{Binding ResetDefaultOpenDirectoryCommand}">
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Clear}" />
                            </Button>
                        </iwk:SimpleStackPanel>
                    </ui:SettingsCard>
                    <ui:SettingsCard Header="{I18N {x:Static l:LangKeys.DefaultExportDirectoryHeader}}">
                        <ui:SettingsCard.Description>
                            <Grid>
                                <TextBlock Text="{Binding Settings.DefaultExportDirectory}" />
                                <TextBlock Text="{I18N {x:Static l:LangKeys.DefaultExportDirectoryDescription}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.DefaultExportDirectory}"
                                                             Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </ui:SettingsCard.Description>
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.SaveLocal}" />
                        </ui:SettingsCard.HeaderIcon>
                        <iwk:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                            <Button Command="{Binding SetDefaultExportDirectoryCommand}">
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Search}" />
                            </Button>
                            <Button Command="{Binding ResetDefaultExportDirectoryCommand}">
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Clear}" />
                            </Button>
                        </iwk:SimpleStackPanel>
                    </ui:SettingsCard>
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                               Text="{I18N {x:Static l:LangKeys.UserInterfaceSettingsHeader}}" />
                    <ui:SettingsCard Description="{I18N  {x:Static l:LangKeys.LanguageDescription}}"
                                     Header="{I18N {x:Static l:LangKeys.LanguageHelpText}}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Globe}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox
                            DisplayMemberPath="NativeName"
                            ItemsSource="{Binding SupportedCultures}"
                            SelectedItem="{Binding Settings.Language, Converter={StaticResource StringToCultureInfoConverter}}" />
                    </ui:SettingsCard>
                </iwk:SimpleStackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>