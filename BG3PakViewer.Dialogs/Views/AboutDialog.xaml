<Window x:Class="BG3PakViewer.Dialogs.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:sf="http://schemas.syncfusion.com/wpf"
        xmlns:data="clr-namespace:Syncfusion.Data;assembly=Syncfusion.Data.WPF"
        xmlns:g="clr-namespace:System.Globalization;assembly=System.Runtime"
        xmlns:c="clr-namespace:BG3PakViewer.Dialogs.Comparers"
        xmlns:vm="clr-namespace:BG3PakViewer.Dialogs.ViewModels"
        xmlns:l="clr-namespace:BG3PakViewer.Locales;assembly=BG3PakViewer.Locales"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        WindowChrome.IsHitTestVisibleInChrome="True"
        d:DataContext="{d:DesignInstance Type=vm:AboutDialogViewModel}"
        WindowStartupLocation="CenterScreen"
        Title="{I18N {x:Static l:LangKeys.About}}" Height="800" Width="800">
    <Window.Resources>
        <ResourceDictionary>
            <c:RuntimeLibraryVersionComparer x:Key="RuntimeLibraryVersionComparer" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Text="{I18N {x:Static l:LangKeys.About}}" />
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:FontIcon
                    Width="100"
                    Margin="16,16,16,0"
                    FontSize="50"
                    Icon="{x:Static ui:SegoeFluentIcons.Info}" />
                <Grid
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,16,0,0"
                    VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Right" Text="{I18N {x:Static l:LangKeys.AboutDialogVersion}}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Text="{Binding AboutInfo[Version],Mode=OneTime}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        Text="{I18N {x:Static l:LangKeys.AboutDialogBuildTime}}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        Text="{Binding AboutInfo[BuildTime], ConverterCulture={x:Static g:CultureInfo.CurrentCulture},Mode=OneTime}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        Text="{I18N {x:Static l:LangKeys.AboutDialogOS}}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="2"
                        Text="{Binding AboutInfo[OS],Mode=OneTime}" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        Text="{I18N {x:Static l:LangKeys.AboutDialogRuntime}}" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="2"
                        Text="{Binding AboutInfo[Runtime],Mode=OneTime}" />
                </Grid>
                <sf:SfDataGrid
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="16"
                    RowHeight="28"
                    ColumnSizer="AutoWithLastColumnFill"
                    AutoGenerateColumns="False"
                    AllowResizingColumns="True"
                    ItemsSource="{Binding AboutInfo[Package],Mode=OneTime}">
                    <sf:SfDataGrid.SortComparers>
                        <data:SortComparer Comparer="{StaticResource RuntimeLibraryVersionComparer}"
                                           PropertyName="Version" />
                    </sf:SfDataGrid.SortComparers>
                    <sf:SfDataGrid.Columns>
                        <sf:GridTextColumn HeaderText="{I18N {x:Static l:LangKeys.Dependencies}}" MappingName="Name" />
                        <sf:GridTextColumn HeaderText="{I18N {x:Static l:LangKeys.Version}}" MappingName="Version"
                                           Width="200" />
                    </sf:SfDataGrid.Columns>
                </sf:SfDataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>