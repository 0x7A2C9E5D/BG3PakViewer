<Window x:Class="BG3PakViewer.Dialogs.Views.RecentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:BG3PakViewer.Dialogs.ViewModels"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:sf="http://schemas.syncfusion.com/wpf"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:b="clr-namespace:BG3PakViewer.Dialogs.Behaviors"
        xmlns:c="clr-namespace:BG3PakViewer.Contracts;assembly=BG3PakViewer.Contracts"
        xmlns:l="clr-namespace:BG3PakViewer.Locales;assembly=BG3PakViewer.Locales"
        xmlns:s="clr-namespace:BG3PakViewer.Shared.Behaviors;assembly=BG3PakViewer.Shared"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        WindowChrome.IsHitTestVisibleInChrome="True"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RecentDialogViewModel}"
        WindowStartupLocation="CenterScreen"
        Title="{I18N {x:Static l:LangKeys.Recent}}" Height="800" Width="1200">
    <Window.Resources>
        <ControlTemplate x:Key="PinCheckBoxTemplate" TargetType="CheckBox">
            <Grid>
                <ui:FontIcon x:Name="iconElement" Glyph="&#xe734;" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <!-- ReSharper disable once Xaml.DependencyPropertyResolveError -->
                    <Setter TargetName="iconElement" Property="ui:FontIcon.Glyph"
                            Value="&#xE735;" />
                </Trigger>
                <Trigger Property="IsChecked" Value="{x:Null}">
                    <!-- ReSharper disable once Xaml.DependencyPropertyResolveError -->
                    <Setter TargetName="iconElement" Property="ui:FontIcon.Glyph"
                            Value="&#xE734;" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Text="{I18N {x:Static l:LangKeys.Recent}}" />
            <ui:AutoSuggestBox
                Grid.Column="1"
                VerticalAlignment="Center"
                PlaceholderText="{I18N {x:Static l:LangKeys.Search}}"
                QuerySubmitted="SearchBox_QuerySubmitted"
                TextChanged="SearchBox_TextChanged">
                <ui:AutoSuggestBox.QueryIcon>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Search}" />
                </ui:AutoSuggestBox.QueryIcon>
            </ui:AutoSuggestBox>
        </Grid>
        <sf:SfDataGrid
            x:Name="SfDataGrid"
            Grid.Row="1"
            Margin="16,16,16,0"
            AllowDeleting="True"
            AllowResizingColumns="True"
            AutoGenerateColumns="False"
            ItemsSource="{Binding PagedSource, ElementName=SfDataPager, Mode=TwoWay}"
            NavigationMode="Row"
            RowHeight="30"
            SelectionMode="Extended"
            ShowRowHeader="True"
            GridPasteOption="None">
            <sf:SfDataGrid.Resources>
                <ResourceDictionary>
                    <Style TargetType="sf:GridRowHeaderCell">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="sf:GridRowHeaderCell">
                                    <Border
                                        x:Name="PART_RowHeaderCellBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                        <Grid>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="{Binding RowIndex, RelativeSource={RelativeSource TemplatedParent}}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </sf:SfDataGrid.Resources>
            <i:Interaction.Behaviors>
                <b:SfDataGridRowHeightBehavior MinHeight="{Binding ElementName=SfDataGrid, Path=RowHeight}" />
            </i:Interaction.Behaviors>
            <sf:SfDataGrid.Columns>
                <sf:GridTextColumn
                    ColumnSizer="AutoWithLastColumnFill"
                    HeaderText="{I18N {x:Static l:LangKeys.Path}}"
                    MappingName="FilePath"
                    MinimumWidth="700"
                    TextWrapping="WrapWithOverflow" />
                <sf:GridDateTimeColumn
                    ColumnSizer="SizeToHeader"
                    HeaderText="{I18N {x:Static l:LangKeys.OpenedTime}}"
                    MappingName="OpenedTime"
                    MinimumWidth="200"
                    Pattern="FullDateTime"
                    TextAlignment="Center" />
                <sf:GridTemplateColumn
                    HorizontalAlignment="Center"
                    ColumnSizer="SizeToHeader"
                    HeaderText="{I18N {x:Static l:LangKeys.Mark}}"
                    MappingName="IsMarked"
                    MinimumWidth="100">
                    <sf:GridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type c:IRecentFileEntry}">
                            <CheckBox
                                HorizontalAlignment="Center"
                                IsChecked="{Binding IsMarked}"
                                Template="{StaticResource PinCheckBoxTemplate}" />
                        </DataTemplate>
                    </sf:GridTemplateColumn.CellTemplate>
                </sf:GridTemplateColumn>
                <sf:GridTemplateColumn
                    HorizontalAlignment="Center"
                    AllowSorting="False"
                    ColumnSizer="SizeToHeader"
                    HeaderText="{I18N {x:Static l:LangKeys.Open}}"
                    MappingName="Null"
                    MinimumWidth="100">
                    <sf:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                HorizontalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=DataContext.OpenCommand}"
                                CommandParameter="{Binding}">
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Go}" />
                            </Button>
                        </DataTemplate>
                    </sf:GridTemplateColumn.CellTemplate>
                </sf:GridTemplateColumn>
            </sf:SfDataGrid.Columns>
            <sf:SfDataGrid.SortColumnDescriptions>
                <sf:SortColumnDescription ColumnName="OpenedTime" SortDirection="Descending" />
            </sf:SfDataGrid.SortColumnDescriptions>
        </sf:SfDataGrid>
        <sf:SfDataPager
            x:Name="SfDataPager"
            Grid.Row="2"
            Margin="0,4"
            HorizontalAlignment="Center"
            NumericButtonCount="10"
            PageSize="30"
            Source="{Binding RecentItems}">
            <i:Interaction.Behaviors>
                <s:SfDataPagerBehavior />
            </i:Interaction.Behaviors>
        </sf:SfDataPager>
    </Grid>
</Window>