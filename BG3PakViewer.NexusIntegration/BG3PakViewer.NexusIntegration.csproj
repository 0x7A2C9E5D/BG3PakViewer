<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platforms>x64</Platforms>
        <!-- ZeroQL generates a member that hides an inherited one; the warning is in generated code. -->
        <NoWarn>$(NoWarn);CS0108</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ZeroQL" Version="8.0.0"/>
    </ItemGroup>

</Project>
