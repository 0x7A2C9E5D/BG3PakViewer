<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <DebugType>embedded</DebugType>
        <!-- Release is the configuration the shipped build uses: a new compiler or analyzer warning fails
             it there instead of being buried in the log, while Debug stays warning-only for the dev loop. -->
        <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Nerdbank.GitVersioning" Condition="!Exists('packages.config')">
            <PrivateAssets>all</PrivateAssets>
            <Version>3.10.94</Version>
        </PackageReference>
    </ItemGroup>
</Project>
