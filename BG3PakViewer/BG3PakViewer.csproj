<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <Platforms>x64</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Antelcat.I18N.WPF" Version="1.1.0"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="HanumanInstitute.MvvmDialogs" Version="2.4.0"/>
        <PackageReference Include="HanumanInstitute.MvvmDialogs.Wpf" Version="2.4.0"/>
        <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.11.0"/>
        <PackageReference Include="LinkDotNet.BuildInformation" Version="2.2.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0">
            <!-- HelixToolkit.SharpDX declares Roslyn as a runtime dependency, but the app does not use it. -->
            <ExcludeAssets>runtime</ExcludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.11.0">
            <ExcludeAssets>runtime</ExcludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0"/>
        <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="11.0.0"/>
        <PackageReference Include="Serilog" Version="4.4.0"/>
        <PackageReference Include="Serilog.Extensions.Logging" Version="11.0.0"/>
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
        <PackageReference Include="Serilog.Sinks.Observable" Version="3.0.0"/>
        <PackageReference Include="SonarAnalyzer.CSharp" Version="10.36.0.15337">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.Reactive" Version="7.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="LSLib">
            <HintPath>D:\Tools\Packed\LSLib.dll</HintPath>
        </Reference>
        <Content Include="D:\Tools\Packed\granny2.dll">
            <Link>granny2.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Page Update="Views\MainWindow.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Syncfusion.lic"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Syncfusion.lic"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BG3PakViewer.Contracts\BG3PakViewer.Contracts.csproj"/>
        <ProjectReference Include="..\BG3PakViewer.Controls\BG3PakViewer.Controls.csproj"/>
        <ProjectReference Include="..\BG3PakViewer.Dialogs\BG3PakViewer.Dialogs.csproj"/>
        <ProjectReference Include="..\BG3PakViewer.IconAtlas\BG3PakViewer.IconAtlas.csproj" />
        <ProjectReference Include="..\BG3PakViewer.Loader\BG3PakViewer.Loader.csproj"/>
        <ProjectReference Include="..\BG3PakViewer.Locales\BG3PakViewer.Locales.csproj"/>
        <ProjectReference Include="..\BG3PakViewer.NexusIntegration\BG3PakViewer.NexusIntegration.csproj"/>
        <ProjectReference Include="..\BG3PakViewer.Utils\BG3PakViewer.Utils.csproj"/>
        <ProjectReference Include="..\BG3PakViewer.VirtualTextures\BG3PakViewer.VirtualTextures.csproj"/>
    </ItemGroup>

</Project>
