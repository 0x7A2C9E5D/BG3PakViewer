<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BG3PakViewer.Controls.ViewModels"
                    xmlns:l="clr-namespace:BG3PakViewer.Locales;assembly=BG3PakViewer.Locales">
    <!--
      Preview for icon atlases. The atlas is sliced into its icon grid and every cell is shown at the
      size it has in the atlas.
      The icons are a flat list and the wrap panel puts as many of them on a line as the width of the
      preview allows, so a sheet is never previewed as a strip that has to be scrolled sideways.
    -->
    <DataTemplate x:Key="IconAtlasPreviewTemplate" DataType="{x:Type vm:IconAtlasPreviewViewModel}">
        <DataTemplate.Resources>
            <!-- Menu item of the floating action button: a subtle button that spans the popup. -->
            <Style x:Key="ExportMenuButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextFillColorDisabledBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </DataTemplate.Resources>
        <Border BorderBrush="Gray" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <ListBox ItemsSource="{Binding Items}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:IconAtlasCellViewModel}">
                            <!--
                              The selection is a checkbox so a click on the icon toggles IsSelected directly;
                              the template drops the checkbox chrome and only keeps its content.
                            -->
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Focusable="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0"
                                      Margin="0"
                                      MinWidth="0"
                                      MinHeight="0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </CheckBox.Template>
                                <CheckBox.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding Mode="OneWay" StringFormat="U: [{0:f4}, {1:f4}]">
                                                        <Binding Path="Uv[0]" Mode="OneWay" />
                                                        <Binding Path="Uv[2]" Mode="OneWay" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding Mode="OneWay" StringFormat="V: [{0:f4}, {1:f4}]">
                                                        <Binding Path="Uv[1]" Mode="OneWay" />
                                                        <Binding Path="Uv[3]" Mode="OneWay" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="S: {0}(W) × {1}(H)">
                                                        <Binding Path="Width" Mode="OneWay" />
                                                        <Binding Path="Height" Mode="OneWay" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </CheckBox.ToolTip>
                                <Border Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        BorderThickness="1"
                                        Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#33808080" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Image Source="{Binding Image}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <!-- Accent check badge of the selected icon. -->
                                        <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
                                        <Viewbox Width="18" Height="18"
                                                 Margin="3"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                                 IsHitTestVisible="False"
                                                 Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Canvas Width="20" Height="20">
                                                <Ellipse Width="20" Height="20"
                                                         Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                                <Path Data="M5.5,10.5 L9,14 L15,7.5"
                                                      Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                      StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!--
                  Floating circular action button at the bottom right of the preview. The colors come
                  from the theme brushes so it follows both the light and the dark theme. Clicking it
                  opens the export menu; the popup closes itself when the user clicks elsewhere.
                -->
                <Grid Margin="16"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <ToggleButton x:Name="ActionsToggle"
                                  Width="40" Height="40"
                                  Background="{DynamicResource AccentFillColorDefaultBrush}"
                                  BorderThickness="0"
                                  Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                  ToolTipService.ToolTip="{I18N {x:Static l:LangKeys.MoreActions}}">
                        <ToggleButton.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.45" Color="Black" />
                        </ToggleButton.Effect>
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <TextBlock Text="&#xE712;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" />
                    </ToggleButton>
                    <!--
                      Export menu. The items are plain buttons so the popup keeps working without a
                      context menu, which cannot be opened from a left click in a template alone.
                    -->
                    <Popup IsOpen="{Binding IsChecked, ElementName=ActionsToggle, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=ActionsToggle}"
                           Placement="Top"
                           VerticalOffset="-8"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource FlyoutPresenterBackground}"
                                BorderBrush="{DynamicResource FlyoutPresenterBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black" />
                            </Border.Effect>
                            <StackPanel MinWidth="120">
                                <Button Command="{Binding ExportSelectedCommand}"
                                        Content="{I18N {x:Static l:LangKeys.ExportSelectedIcons}}"
                                        Style="{StaticResource ExportMenuButtonStyle}" />
                                <Button Command="{Binding ExportAllCommand}"
                                        Content="{I18N {x:Static l:LangKeys.ExportAllIcons}}"
                                        Style="{StaticResource ExportMenuButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>