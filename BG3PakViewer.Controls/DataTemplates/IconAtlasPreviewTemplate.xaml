<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BG3PakViewer.Controls.ViewModels"
                    xmlns:l="clr-namespace:BG3PakViewer.Locales;assembly=BG3PakViewer.Locales">
    <!--
      Preview for icon atlases. The atlas is sliced into its icon grid and every cell is shown at the
      size it has in the atlas.
      The icons are a flat list and the wrap panel puts as many of them on a line as the width of the
      preview allows, so a sheet is never previewed as a strip that has to be scrolled sideways.
    -->
    <DataTemplate x:Key="IconAtlasPreviewTemplate" DataType="{x:Type vm:IconAtlasPreviewViewModel}">
        <Border BorderBrush="Gray" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <ListBox ItemsSource="{Binding Items}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <!--
                      Right-click menu for the whole preview. The menu is not part of the visual tree,
                      so its data context is taken from the list box it is opened on.
                    -->
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{I18N {x:Static l:LangKeys.SelectAll}}"
                                      InputGestureText="Ctrl+A"
                                      Command="{Binding SelectAllCommand}" />
                            <MenuItem Header="{I18N {x:Static l:LangKeys.InvertSelection}}"
                                      InputGestureText="Ctrl+Shift+I"
                                      Command="{Binding InvertSelectionCommand}" />
                            <MenuItem Header="{I18N {x:Static l:LangKeys.ClearSelection}}"
                                      InputGestureText="Ctrl+D"
                                      Command="{Binding ClearSelectionCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:IconAtlasCellViewModel}">
                            <!--
                              The selection is a checkbox so a click on the icon toggles IsSelected directly;
                              the template drops the checkbox chrome and only keeps its content.
                            -->
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Focusable="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0"
                                      Margin="0"
                                      MinWidth="0"
                                      MinHeight="0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </CheckBox.Template>
                                <CheckBox.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding Mode="OneWay" StringFormat="U: [{0:f4}, {1:f4}]">
                                                        <Binding Path="Uv[0]" Mode="OneWay" />
                                                        <Binding Path="Uv[2]" Mode="OneWay" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding Mode="OneWay" StringFormat="V: [{0:f4}, {1:f4}]">
                                                        <Binding Path="Uv[1]" Mode="OneWay" />
                                                        <Binding Path="Uv[3]" Mode="OneWay" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="S: {0}(W) × {1}(H)">
                                                        <Binding Path="Width" Mode="OneWay" />
                                                        <Binding Path="Height" Mode="OneWay" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </CheckBox.ToolTip>
                                <Border Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#33808080" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#664CC2FF" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Image Source="{Binding Image}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <!-- Accent check badge of the selected icon. -->
                                        <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
                                        <Viewbox Width="18" Height="18"
                                                 Margin="3"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                                 IsHitTestVisible="False"
                                                 Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Canvas Width="20" Height="20">
                                                <Ellipse Width="20" Height="20" Fill="#FF4CC2FF" />
                                                <Path Data="M5.5,10.5 L9,14 L15,7.5"
                                                      Stroke="White"
                                                      StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!--
                  Floating circular action button at the bottom right of the preview. The colors come
                  from the theme brushes so it follows both the light and the dark theme.
                -->
                <Button Width="40" Height="40"
                        Margin="16"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        ToolTip="更多操作">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black" />
                    </Button.Effect>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="20">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="&#xE712;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14" />
                </Button>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>