<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BG3PakViewer.Controls.ViewModels"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors">
    <!--
      Preview for Larian resource files: a structural tree on the left and a
      detail panel on the right showing the selected node's attributes. The tree
      mirrors the main file tree (gray border + IconAndText) so both panels read
      as siblings. Attributes are shown in the detail panel, never on a tree row.
    -->
    <DataTemplate x:Key="LarianResourcePreviewDataTemplate" DataType="{x:Type vm:LarianResourcePreviewViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition MinWidth="300" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="ResourceTree" Grid.Column="0"
                      ItemsSource="{Binding RootNodes}"
                      BorderBrush="Gray" BorderThickness="1" Padding="10"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      VirtualizingStackPanel.CacheLength="30"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}"
                                              DataType="{x:Type vm:LarianResourceNodeViewModel}">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectedItemChanged">
                        <i:InvokeCommandAction Command="{Binding SelectNodeCommand}"
                                               CommandParameter="{Binding SelectedItem, ElementName=ResourceTree, Mode=OneWay}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding SelectedNode.Name, FallbackValue=Properties}"
                               FontWeight="SemiBold" Margin="0,0,0,8" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <!-- ReSharper disable once Xaml.PossibleNullReferenceException -->
                        <ItemsControl ItemsSource="{Binding SelectedNode.Attributes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LarianAttributeViewModel}">
                                    <TextBlock Text="{Binding DisplayText}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>