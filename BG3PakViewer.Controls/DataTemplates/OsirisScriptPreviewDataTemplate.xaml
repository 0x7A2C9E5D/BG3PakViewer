<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
                    xmlns:vm="clr-namespace:BG3PakViewer.Controls.ViewModels">
    <DataTemplate x:Key="OsirisScriptPreviewDataTemplate" DataType="{x:Type vm:OsirisScriptPreviewViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ComboBox ui:ControlHelper.Header="Goal" ItemsSource="{Binding Goals}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedGoal}"
                      MinWidth="300" />
            <Button Grid.Row="0" HorizontalAlignment="Right" Content="Decompile"
                    Command="{Binding DecompileScriptsCommand}" />
            <TextBox Grid.Row="1" IsReadOnly="True" Margin="0,10,0,0" Text="{Binding Scripts,Mode=OneWay}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>