<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
                    xmlns:l="clr-namespace:BG3PakViewer.Locales;assembly=BG3PakViewer.Locales"
                    xmlns:vm="clr-namespace:BG3PakViewer.Controls.ViewModels">
    <DataTemplate x:Key="OsirisScriptPreviewDataTemplate" DataType="{x:Type vm:OsirisScriptPreviewViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ComboBox ItemsSource="{Binding Goals}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedGoal}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.CacheLength="50"
                      ScrollViewer.CanContentScroll="True">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Command="{Binding DecompileScriptsCommand}">
                <ui:IconAndText Icon="{x:Static ui:SegoeFluentIcons.Code}"
                                Content="{I18N {x:Static l:LangKeys.Decompile}}" />
            </Button>
            <TextBox Grid.Row="1" IsReadOnly="True" Margin="0,10,0,0" Text="{Binding Scripts,Mode=OneWay}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>