<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BG3PakViewer.Controls.ViewModels"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:b="clr-namespace:BG3PakViewer.Controls.Behaviors">
    <!--
      Preview for GTS virtual textures: texture list on the left, and the
      selected texture decoded per-layer on the right (with layer selector).
    -->
    <DataTemplate x:Key="GtsPreviewDataTemplate" DataType="{x:Type vm:GtsPreviewViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition MinWidth="400" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      ItemsSource="{Binding Textures}"
                      SelectedItem="{Binding SelectedTexture}"
                      BorderBrush="Gray" BorderThickness="1" Padding="5"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GtsTextureItemViewModel}">
                        <Grid Margin="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="{Binding Dimensions}"
                                       Foreground="Gray" FontSize="11" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Layer:" VerticalAlignment="Center" />
                        <ComboBox Width="120" Margin="8,0,0,0" VerticalAlignment="Center"
                                  ItemsSource="{Binding Layers}"
                                  SelectedIndex="{Binding SelectedLayerIndex}" />
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                                   Margin="16,0,0,0" Foreground="Gray" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="#1E1E1E" Margin="0,0,0,8"
                            BorderBrush="Gray" BorderThickness="1">
                        <Image Source="{Binding Preview}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <i:Interaction.Behaviors>
                                <b:ImageBehavior />
                            </i:Interaction.Behaviors>
                        </Image>
                    </Border>

                    <ProgressBar Grid.Row="2" Height="4" Value="{Binding Progress}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
