<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
                    xmlns:vm="clr-namespace:BG3PakViewer.Controls.ViewModels"
                    xmlns:l="clr-namespace:BG3PakViewer.Locales;assembly=BG3PakViewer.Locales">
    <!--
      Virtual texture files have no per-file preview: both the tile set and its page files point the
      user at the virtual texture preview export tool, which is where they are searched and exported.
    -->
    <DataTemplate x:Key="VirtualTexturePromptDataTemplate"
                  DataType="{x:Type vm:VirtualTexturePromptViewModel}">
        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.MapLayers}" FontSize="40"
                             HorizontalAlignment="Center" Foreground="Gray" />
                <TextBlock Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap"
                           Text="{I18N {x:Static l:LangKeys.VirtualTexturePrompt}}" />
                <TextBlock Margin="0,8,0,0" Foreground="Gray" FontSize="12" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" Text="{Binding FileName}" />
                <Button Margin="0,20,0,0" Padding="16,8" HorizontalAlignment="Center"
                        Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=DataContext.ShowVtToolboxCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Export}" FontSize="14" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                   Text="{I18N {x:Static l:LangKeys.VtToolbox}}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
