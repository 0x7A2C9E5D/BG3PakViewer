<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BG3PakViewer.Controls.ViewModels"
                    xmlns:sf="http://schemas.syncfusion.com/wpf"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:b="clr-namespace:BG3PakViewer.Shared.Behaviors;assembly=BG3PakViewer.Shared">
    <!--
      Preview for Larian localization files (.loca): a data grid with one row per
      localization entry (Key / Version / Text), paged with SfDataPager.
    -->
    <DataTemplate x:Key="LocalizationPreviewDataTemplate" DataType="{x:Type vm:LocalizationPreviewViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <sf:SfDataGrid x:Name="SfDataGrid"
                           Grid.Row="0"
                           ItemsSource="{Binding PagedSource, ElementName=SfDataPager, Mode=OneWay}"
                           AutoGenerateColumns="False"
                           AllowSorting="True"
                           AllowResizingColumns="True"
                           HeaderRowHeight="28"
                           RowHeight="28"
                           SelectionMode="Single"
                           NavigationMode="Row"
                           EnableDataVirtualization="True">
                <sf:SfDataGrid.Columns>
                    <sf:GridTextColumn
                        ColumnSizer="SizeToCells"
                        HeaderText="Id"
                        MappingName="Key"
                        MinimumWidth="300"
                        TextAlignment="Center" />
                    <sf:GridTextColumn
                        ColumnSizer="SizeToHeader"
                        MappingName="Version"
                        MinimumWidth="80"
                        TextAlignment="Center" />
                    <sf:GridTextColumn
                        ColumnSizer="AutoWithLastColumnFill"
                        HeaderText="Content"
                        MappingName="Text"
                        MinimumWidth="300"
                        TextWrapping="WrapWithOverflow" />
                </sf:SfDataGrid.Columns>
                <i:Interaction.Behaviors>
                    <!--
                      The content column wraps, so a row has to grow past RowHeight when an entry does
                      not fit on one line. Without this behavior every row stays at the fixed 28px and
                      the wrapped text is clipped. MinHeight is a literal because inside a DataTemplate
                      the behavior has no namescope, so an ElementName binding on it cannot resolve.
                    -->
                    <b:SfDataGridRowHeightBehavior MinHeight="28" />
                    <b:SfDataGridSearchBehavior />
                </i:Interaction.Behaviors>
            </sf:SfDataGrid>

            <sf:SfDataPager x:Name="SfDataPager"
                            Grid.Row="1"
                            Margin="0,4"
                            HorizontalAlignment="Center"
                            NumericButtonCount="10"
                            PageSize="100"
                            Source="{Binding Entries}">
                <i:Interaction.Behaviors>
                    <b:SfDataPagerBehavior />
                </i:Interaction.Behaviors>
            </sf:SfDataPager>
        </Grid>
    </DataTemplate>
</ResourceDictionary>