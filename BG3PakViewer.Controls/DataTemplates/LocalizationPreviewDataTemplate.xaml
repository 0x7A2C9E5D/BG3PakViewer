<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BG3PakViewer.Controls.ViewModels"
                    xmlns:sf="http://schemas.syncfusion.com/wpf">
    <!--
      Preview for Larian localization files (.loca): a data grid with one row per
      localization entry (Key / Version / Text), paged with SfDataPager.
    -->
    <DataTemplate x:Key="LocalizationPreviewDataTemplate" DataType="{x:Type vm:LocalizationPreviewViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <sf:SfDataGrid x:Name="SfDataGrid"
                           Grid.Row="0"
                           ItemsSource="{Binding PagedSource, ElementName=SfDataPager, Mode=OneWay}"
                           AutoGenerateColumns="False"
                           AllowSorting="True"
                           AllowResizingColumns="True"
                           HeaderRowHeight="28"
                           RowHeight="28"
                           SelectionMode="Single"
                           NavigationMode="Row">
                <sf:SfDataGrid.Columns>
                    <sf:GridTextColumn
                        ColumnSizer="SizeToCells"
                        HeaderText="Id"
                        MappingName="Key"
                        MinimumWidth="220"
                        TextAlignment="Left" />
                    <sf:GridTextColumn
                        ColumnSizer="SizeToHeader"
                        HeaderText="Version"
                        MappingName="Version"
                        MinimumWidth="80"
                        TextAlignment="Center" />
                    <sf:GridTextColumn
                        ColumnSizer="AutoWithLastColumnFill"
                        HeaderText="Text"
                        MappingName="Text"
                        MinimumWidth="300"
                        TextWrapping="WrapWithOverflow" />
                </sf:SfDataGrid.Columns>
            </sf:SfDataGrid>

            <sf:SfDataPager x:Name="SfDataPager"
                            Grid.Row="1"
                            Margin="0,4"
                            HorizontalAlignment="Center"
                            NumericButtonCount="10"
                            PageSize="100"
                            Source="{Binding Rows}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
