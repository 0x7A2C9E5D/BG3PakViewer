<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BG3PakViewer.Controls.ViewModels"
                    xmlns:sf="http://schemas.syncfusion.com/wpf"
                    xmlns:l="clr-namespace:BG3PakViewer.Locales;assembly=BG3PakViewer.Locales">
    <!--
      Preview for Larian localization files (.loca): a data grid with one row per
      localization entry (Key / Version / Text).
    -->
    <DataTemplate x:Key="LocalizationPreviewDataTemplate" DataType="{x:Type vm:LocalizationPreviewViewModel}">
        <sf:SfDataGrid ItemsSource="{Binding Rows}"
                       AutoGenerateColumns="False"
                       AllowSorting="True"
                       AllowResizingColumns="True"
                       AllowFrozenGroupHeaders="True"
                       HeaderRowHeight="28"
                       RowHeight="28"
                       SelectionMode="Single"
                       NavigationMode="Row">
            <sf:SfDataGrid.Columns>
                <sf:GridTextColumn
                    ColumnSizer="SizeToHeader"
                    HeaderText="Id"
                    MappingName="Key"
                    MinimumWidth="220"
                    TextAlignment="Left" />
                <sf:GridTextColumn
                    ColumnSizer="SizeToHeader"
                    HeaderText="Version"
                    MappingName="Version"
                    MinimumWidth="80"
                    TextAlignment="Center" />
                <sf:GridTextColumn
                    ColumnSizer="AutoWithLastColumnFill"
                    HeaderText="Text"
                    MappingName="Text"
                    MinimumWidth="300"
                    TextWrapping="WrapWithOverflow" />
            </sf:SfDataGrid.Columns>
        </sf:SfDataGrid>
    </DataTemplate>
</ResourceDictionary>
