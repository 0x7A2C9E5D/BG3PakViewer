<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BG3PakViewer.Controls.ViewModels"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:b="clr-namespace:BG3PakViewer.Controls.Behaviors">
    <DataTemplate x:Key="ImageFilePreviewTemplate" DataType="{x:Type vm:ImageFileViewModel}">
        <Image Source="{Binding Data, NotifyOnTargetUpdated=True}">
            <i:Interaction.Behaviors>
                <b:ImageBehavior />
            </i:Interaction.Behaviors>
        </Image>
    </DataTemplate>
</ResourceDictionary>