<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BG3PakViewer.Controls.ViewModels"
                    xmlns:c="clr-namespace:BG3PakViewer.Shared.Converters;assembly=BG3PakViewer.Shared">
    <c:ImageToBitmapSourceConverter x:Key="ImageToBitmapSourceConverter" />
    <DataTemplate x:Key="ImageFilePreviewTemplate" DataType="{x:Type vm:ImagePreviewViewModel}">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
            <Image Source="{Binding Preview, Converter={StaticResource ImageToBitmapSourceConverter}}"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Viewbox>
    </DataTemplate>
</ResourceDictionary>